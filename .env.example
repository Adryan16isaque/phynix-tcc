# Copie para ".env" na RAIZ do projeto (cp .env.example .env) e edite os valores.
# NUNCA envie o arquivo .env ao GitHub.

# Banco de dados (usado pelo MySQL e pela aplicação)
DB_NAME=phynix
DB_PASS=troque-por-uma-senha-forte

# IA (Groq). Gere a chave em https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: várias chaves separadas por vírgula (rodízio)
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# Endereço exato que aparece no navegador (com http/https e porta).
# Local:    http://localhost:8080
# Servidor: https://seu-dominio-ou-url-publica
ALLOWED_ORIGINS=http://localhost:8080

# development = acesso local por http | production = acesso por HTTPS
APP_ENV=development
