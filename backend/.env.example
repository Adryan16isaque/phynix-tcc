# ═══════════════════════════════════════════════════════════
# .env.example — Copie para .env e preencha com seus valores
#   cp backend/.env.example backend/.env
# ═══════════════════════════════════════════════════════════

# ── Banco de dados ──────────────────────────────────────────
DB_HOST=localhost
DB_NAME=phynix
DB_USER=root
DB_PASS=

# ── Groq API ─────────────────────────────────────────────────
GROQ_API_KEY=coloque_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# ── CORS ─────────────────────────────────────────────────────
# Ex.: ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=

# ── Ambiente ─────────────────────────────────────────────────
# development | production
APP_ENV=development
